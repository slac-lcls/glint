#!/bin/sh
# Pre-push guard: run check_numbers.py before anything leaves the machine.
#
# Two modes, because the deliverables are spread across repos:
#
#   STRICT (default in ~/git/papers/glint)  -- a failure BLOCKS the push. The paper is the artifact
#       that goes to Overleaf and from there to collaborators and a journal; a stale derived number
#       there is the expensive kind.
#
#   WARN (default in ~/git/glint)           -- a failure prints and lets the push through. The
#       checker's targets (glint.tex, the deck builders) are NOT in this repo, so blocking a code
#       push because a slide deck drifted would be the wrong coupling: you would be unable to ship
#       an engine fix until an unrelated document was tidied.
#
# Override per invocation:   GLINT_NUMCHECK=strict|warn|off git push
# Install:                   experiments/hooks/install.sh
set -u

# Prefer the checker in the repo BEING PUSHED. A hardcoded path here made the guard blind to the one
# change it most needs to see: a FACTS edit. glint-claude is a worktree of glint, so it shares this
# hook, and with $HOME/git/glint hardcoded a push of stream_ms 4.16 -> 3.64 was validated against the
# OTHER checkout's 4.16 -- under which the deliverables still quoting 4.16 look correct. It printed
# OK and let through the 12 sites it exists to catch. Fall back to the canonical checkout only for
# repos that do not carry the checker at all (papers/glint, where the hook runs strict).
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$REPO_ROOT" ] || REPO_ROOT="$PWD"          # hooks run from the top of the working tree
if [ -n "${GLINT_NUMCHECK_PATH:-}" ]; then
    CHECKER="$GLINT_NUMCHECK_PATH"
elif [ -f "$REPO_ROOT/experiments/check_numbers.py" ]; then
    CHECKER="$REPO_ROOT/experiments/check_numbers.py"
else
    CHECKER="$HOME/git/glint/experiments/check_numbers.py"
fi
MODE="${GLINT_NUMCHECK:-@MODE@}"

[ "$MODE" = "off" ] && exit 0

if [ ! -f "$CHECKER" ]; then
    echo "pre-push: check_numbers.py not found at $CHECKER -- skipping (set GLINT_NUMCHECK_PATH)" >&2
    exit 0
fi

# Say WHICH checker ran. The failure above was silent precisely because it did not.
echo "pre-push: checking deliverable numbers ($CHECKER) ..."
if python3 "$CHECKER" --pdf; then
    exit 0
fi

if [ "$MODE" = "strict" ]; then
    cat >&2 <<'MSG'

pre-push: BLOCKED -- a deliverable contradicts the measured numbers.

Fix the file, or -- if a measurement genuinely changed -- update FACTS in
check_numbers.py and re-run against every target, so the derived quantities
(frames/s, speedups, tier sizing) move with it.

To push anyway:  GLINT_NUMCHECK=off git push
MSG
    exit 1
fi

cat >&2 <<'MSG'

pre-push: WARNING -- the above deliverables contradict the measured numbers.
Not blocking (they live outside this repo), but they are wrong right now.
MSG
exit 0
