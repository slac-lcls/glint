# K2 (pre-registered headline DIALS known-cell arm): the target cell and symmetry, candidates refined in the
# known symmetry, and the fft1d -> real_space_grid_search fallback list (the second pass of the cctbx.xfel
# two-pass route as commonly configured).
indexing.known_symmetry {
  space_group = P43212
  unit_cell = 68.7 68.7 108.6 90 90 90
}
indexing.stills.refine_candidates_with_known_symmetry = True
indexing.stills.method_list = fft1d real_space_grid_search
